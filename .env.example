# ==============================================================================
# Async Web Automation & Telemetry Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit the active '.env' file containing secrets to source control.

# ------------------------------------------------------------------------------
# Target Endpoints & Routing
# ------------------------------------------------------------------------------
# Root URL of the target web application or SPA portal
TARGET_BASE_URL=https://app.target-platform.internal

# Optional separate API gateway or telemetry router endpoint (defaults to TARGET_BASE_URL if empty)
API_BASE_URL=https://api.target-platform.internal

# Network request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# Authentication & Identity Context
# ------------------------------------------------------------------------------
# Bearer token or OAuth/JWT access token for authenticated API requests
AUTH_TOKEN=your_jwt_or_bearer_token_here

# Unique subject or worker identity identifier
USER_ID=usr_worker_0123456789

# Multi-tenant and organizational routing identifiers
TENANT_ID=enterprise-tenant-alpha
ORGANIZATION_ID=enterprise-org-core

# ------------------------------------------------------------------------------
# Browser Automation & Chrome DevTools Protocol (CDP)
# ------------------------------------------------------------------------------
# Host and port for connecting to an existing browser session with remote debugging enabled
CDP_DEBUG_HOST=127.0.0.1
CDP_DEBUG_PORT=9222

# Headless browser execution flag (true for CI/CD / headless servers, false for visual debugging)
BROWSER_HEADLESS=true

# Explicit wait and action timeout in milliseconds
BROWSER_TIMEOUT_MS=30000

# Slow-down factor in milliseconds for debugging visual interactions
SLOW_MO_MS=0

# ------------------------------------------------------------------------------
# Concurrency & Resilience Policies
# ------------------------------------------------------------------------------
# Maximum number of concurrent async worker tasks (bounded semaphore)
MAX_CONCURRENCY=5

# Maximum retry attempts on transient network or DOM stale reference errors
RETRY_ATTEMPTS=3

# Multiplier factor for exponential backoff delays
RETRY_BACKOFF_FACTOR=1.5

# Consecutive failure threshold before tripping circuit breaker
CIRCUIT_BREAKER_THRESHOLD=5

# ------------------------------------------------------------------------------
# State Persistence & Session Caching
# ------------------------------------------------------------------------------
SESSION_CACHE_DIR=.sessions
SESSION_FILE=.sessions/session_state.json

# ------------------------------------------------------------------------------
# Observability & Structured Logging
# ------------------------------------------------------------------------------
# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Local file path for persistent rotating execution logs
LOG_FILE=logs/automation_engine.log

# Enable telemetry event dispatching and heartbeat monitoring
TELEMETRY_ENABLED=true
